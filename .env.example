NEXT_PUBLIC_SUPABASE_URL=          # safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # safe in the browser, protected by RLS
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. never NEXT_PUBLIC. never client code.
SUPABASE_DB_PASSWORD=              # migrations and psql only. not used by the app.
WORKOS_SECRET_KEY=                 # SERVER ONLY. 32 bytes as hex or base64, e.g.
                                   #   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
                                   # encrypts password fields in the Database section. BACK IT UP: lose it and
                                   # every stored credential becomes unreadable. must be identical everywhere the app runs.
DEMO_LOGINS=                       # set to 1 to show the demo account switcher on /login. never in production.
DEMO_PASSWORD=                     # shared password for the seeded demo users, used only by that switcher.
SEED_PASSWORD=                     # password for the seeded demo users. required by scripts/seed.mjs and scripts/wall-test.mjs.
